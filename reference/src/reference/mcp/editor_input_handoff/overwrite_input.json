{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cmoc editor input overwrite tool input",
  "description": "自由記述項目の goal、instructions、background、decisions、open_questions には、該当する内容がない場合や未確認の場合も、その状態を記述する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_id",
    "goal",
    "instructions",
    "background",
    "decisions",
    "open_questions",
    "references"
  ],
  "properties": {
    "target_id": {
      "$ref": "#/$defs/nonblank_text",
      "description": "人間が明示した引き渡し先の target ID。"
    },
    "goal": {
      "$ref": "#/$defs/nonblank_text",
      "description": "受信側で達成してほしい目標状態。"
    },
    "instructions": {
      "$ref": "#/$defs/nonblank_text",
      "description": "受信側へ依頼する具体的な作業。"
    },
    "background": {
      "$ref": "#/$defs/nonblank_text",
      "description": "依頼の意図・背景。"
    },
    "decisions": {
      "$ref": "#/$defs/nonblank_text",
      "description": "決定事項とその理由。"
    },
    "open_questions": {
      "$ref": "#/$defs/nonblank_text",
      "description": "未確定事項。"
    },
    "references": {
      "type": "array",
      "description": "依頼に関係する文書・ファイルへの参照。参照がなければ空配列にする。参照先の短い説明は各要素の description に記述し、参照理由や詳しい背景は instructions または background に含める。参照先の読み取りは受信側のアクセス規定に従う。",
      "items": {
        "type": "object",
        "description": "説明と、ファイルパスまたは ID による参照。file_path と id の一方だけを指定し、もう一方は null にする。",
        "additionalProperties": false,
        "required": [
          "description",
          "file_path",
          "id"
        ],
        "properties": {
          "description": {
            "$ref": "#/$defs/nonblank_text",
            "description": "参照先が何であるかを示す短い説明。空白だけの文字列や改行を含む文字列は不可。"
          },
          "file_path": {
            "anyOf": [
              { "$ref": "#/$defs/nonblank_text" },
              { "type": "null" }
            ],
            "description": "参照先ファイルの絶対パス。id を指定する場合は null。"
          },
          "id": {
            "anyOf": [
              { "$ref": "#/$defs/nonblank_text" },
              { "type": "null" }
            ],
            "description": "decision または spec の参照先 ID。角括弧を含まない DEC-000000 または SPC-000000 の形式で、数字は6桁。file_path を指定する場合は null。"
          }
        },
        "oneOf": [
          {
            "properties": {
              "file_path": { "type": "string" },
              "id": { "type": "null" }
            }
          },
          {
            "properties": {
              "file_path": { "type": "null" },
              "id": { "type": "string" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "nonblank_text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cmoc editor input overwrite tool input",
  "description": "自由記述項目の goal、instructions、background、decisions、open_questions には、該当する内容がない場合や未確認の場合も、その状態を記述する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_id",
    "goal",
    "instructions",
    "background",
    "decisions",
    "open_questions",
    "oracle_references"
  ],
  "properties": {
    "target_id": {
      "$ref": "#/$defs/nonblank_text",
      "description": "人間が明示した引き渡し先の target ID。"
    },
    "goal": {
      "$ref": "#/$defs/nonblank_text",
      "description": "受信側で達成してほしい目標状態。"
    },
    "instructions": {
      "$ref": "#/$defs/nonblank_text",
      "description": "受信側へ依頼する具体的な作業。"
    },
    "background": {
      "$ref": "#/$defs/nonblank_text",
      "description": "依頼の意図・背景。"
    },
    "decisions": {
      "$ref": "#/$defs/nonblank_text",
      "description": "決定事項とその理由。"
    },
    "open_questions": {
      "$ref": "#/$defs/nonblank_text",
      "description": "未確定事項。"
    },
    "oracle_references": {
      "type": "array",
      "description": "作業に必要な oracle の参照。参照がなければ空配列にする。参照先の簡潔な内容と参照理由は instructions または background に含める。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_path",
          "loc_desc"
        ],
        "properties": {
          "file_path": {
            "$ref": "#/$defs/nonblank_text",
            "description": "参照先の oracle file の絶対パス。"
          },
          "loc_desc": {
            "anyOf": [
              { "$ref": "#/$defs/nonblank_text" },
              { "type": "null" }
            ],
            "description": "参照箇所を示す見出し、識別子、JSON Pointer などの安定した locator。行番号を使わない。ファイル全体を参照する場合は null。"
          }
        }
      }
    }
  },
  "$defs": {
    "nonblank_text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}

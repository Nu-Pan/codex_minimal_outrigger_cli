{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "description": "この agent call が返す所見と対応結果のリスト。所見がない場合は空配列。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "evidences",
          "changed_paths",
          "oracle_requirement",
          "observed_implementation",
          "reason",
          "resolution"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "所見の短い見出し。"
          },
          "evidences": {
            "type": "array",
            "description": "調査時点の所見の根拠となる文言の位置情報。空配列は許容しない。",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line_start",
                "line_end",
                "summary"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "所見の根拠となる file の絶対 path。"
                },
                "line_start": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "所見の根拠となる記述の開始行。行番号を特定できない場合は null。"
                },
                "line_end": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "所見の根拠となる記述の終了行。行番号を特定できない場合は null。"
                },
                "summary": {
                  "type": "string",
                  "description": "該当箇所の短い要約。修正による位置情報の変化を判別するための情報。"
                }
              }
            }
          },
          "changed_paths": {
            "type": "array",
            "description": "この所見への対応によって agent call 終了時点で net 差分が生じた全 file の、正規化済みの `{{work-root}}` 相対 path。absolute path と `..` による `{{work-root}}` 外参照は禁止。対応する net 差分がない場合は空配列。追加と変更は終了時点の path、削除は開始時点の path、rename は rename 前後の path を含む。",
            "items": {
              "type": "string"
            }
          },
          "oracle_requirement": {
            "type": "string",
            "description": "所見に関係する oracle file の要求、または対応する明示要求がない旨。"
          },
          "observed_implementation": {
            "type": "string",
            "description": "調査時点の実装が実際にどうなっていたか。"
          },
          "reason": {
            "type": "string",
            "description": "所見を要修正とする理由。"
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "summary",
              "verification"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "fixed",
                  "unresolved"
                ],
                "description": "所見の対応状態。"
              },
              "summary": {
                "type": "string",
                "description": "実施した修正、または未解消となった理由の要約。"
              },
              "verification": {
                "type": "string",
                "description": "修正後に実施した検証と、その結果の要約。"
              }
            }
          }
        }
      }
    }
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operations"
  ],
  "properties": {
    "operations": {
      "type": "array",
      "description": "入力された所見リストの重複や矛盾を解消するための編集操作リスト。十分コンパクトで整合的な場合は空配列を返す。",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/delete_operation"
          },
          {
            "$ref": "#/$defs/replace_operation"
          },
          {
            "$ref": "#/$defs/merge_operation"
          }
        ]
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "oracle_path",
        "reason"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "description": "所見の重大度。",
          "enum": [
            "fatal",
            "minor"
          ]
        },
        "title": {
          "type": "string",
          "description": "所見の短い見出し。問題の要点が分かるように簡潔に書く。"
        },
        "oracle_path": {
          "type": "string",
          "description": "所見の主な根拠となる oracle file のパス。対象所見群の根拠として最も適切な oracle file を指す。"
        },
        "reason": {
          "type": "string",
          "description": "編集後の所見として扱うべき理由。重複や矛盾をどう整理したかも分かるように書く。"
        }
      }
    },
    "delete_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "finding"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "所見を削除する編集操作。",
          "enum": [
            "delete"
          ]
        },
        "target_ids": {
          "type": "array",
          "description": "削除する所見の finding_id。",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "finding": {
          "type": "null",
          "description": "delete では null。"
        }
      }
    },
    "replace_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "finding"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "単一の所見を置き換える編集操作。",
          "enum": [
            "replace"
          ]
        },
        "target_ids": {
          "type": "array",
          "description": "置き換える所見の finding_id。",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "finding": {
          "$ref": "#/$defs/finding"
        }
      }
    },
    "merge_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "finding"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "複数の所見を統合する編集操作。",
          "enum": [
            "merge"
          ]
        },
        "target_ids": {
          "type": "array",
          "description": "統合元となる複数所見の finding_id。",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "finding": {
          "$ref": "#/$defs/finding"
        }
      }
    }
  }
}

{
  "type": "object",
  "description": "oracle review の所見整理 agent call の出力。",
  "additionalProperties": false,
  "required": [
    "operations"
  ],
  "properties": {
    "operations": {
      "type": "array",
      "description": "入力された所見リストの重複や矛盾を解消するための編集操作リスト。十分コンパクトで整合的な場合は空配列を返す。",
      "items": {
        "description": "所見リストへ適用する編集操作 1 件。",
        "anyOf": [
          {
            "$ref": "#/$defs/delete_operation"
          },
          {
            "$ref": "#/$defs/replace_operation"
          },
          {
            "$ref": "#/$defs/merge_operation"
          }
        ]
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "description": "replace または merge による編集後の所見。",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "oracle_path",
        "reason"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "description": "所見の重大度。fatal は致命的所見、minor は軽微な所見を表す。",
          "enum": [
            "fatal",
            "minor"
          ]
        },
        "title": {
          "type": "string",
          "description": "所見の短い見出し。問題の要点が分かるように簡潔に書く。"
        },
        "oracle_path": {
          "type": "string",
          "description": "所見の主な根拠となる oracle file のパス。対象所見群の根拠として最も適切な oracle file を指す。"
        },
        "reason": {
          "type": "string",
          "description": "編集後の所見として扱うべき理由。重複や矛盾をどう整理したかも分かるように書く。"
        }
      }
    },
    "delete_operation": {
      "type": "object",
      "description": "入力所見を削除する編集操作。",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "finding"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "この編集操作が所見削除であることを表す識別値。",
          "enum": [
            "delete"
          ]
        },
        "target_ids": {
          "type": "array",
          "description": "削除対象を指定する finding_id の配列。",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "description": "入力所見の finding_id。"
          }
        },
        "finding": {
          "type": "null",
          "description": "delete では null。"
        }
      }
    },
    "replace_operation": {
      "type": "object",
      "description": "入力所見を別の所見へ置き換える編集操作。",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "finding"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "この編集操作が単一所見の置換であることを表す識別値。",
          "enum": [
            "replace"
          ]
        },
        "target_ids": {
          "type": "array",
          "description": "置換対象を指定する finding_id の配列。",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "description": "入力所見の finding_id。"
          }
        },
        "finding": {
          "$ref": "#/$defs/finding"
        }
      }
    },
    "merge_operation": {
      "type": "object",
      "description": "複数の入力所見を 1 件へ統合する編集操作。",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "finding"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "この編集操作が複数所見の統合であることを表す識別値。",
          "enum": [
            "merge"
          ]
        },
        "target_ids": {
          "type": "array",
          "description": "統合元を指定する finding_id の配列。",
          "minItems": 2,
          "items": {
            "type": "string",
            "description": "入力所見の finding_id。"
          }
        },
        "finding": {
          "$ref": "#/$defs/finding"
        }
      }
    }
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "existing_issue_id",
    "normalized_issue",
    "related_issue_ids"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "existing",
        "new"
      ],
      "description": "observation を既存 issue へ統合するか、新しい issue とするかの判断。"
    },
    "existing_issue_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "decision=existing の場合に限り、入力候補から選んだ issue ID。"
    },
    "normalized_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "human_action",
        "impact",
        "cause_assessment",
        "presence_assessment"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "人間向けの短い問題要約。"
        },
        "human_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "description": "人間が取り得る具体的な対応候補。"
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "description": "複数 observation から確認できる作業への影響。"
        },
        "cause_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "certainty",
            "description"
          ],
          "properties": {
            "certainty": {
              "type": "string",
              "enum": [
                "supported",
                "suspected",
                "unknown"
              ],
              "description": "構造化された根拠に照らした原因説明の確かさ。"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200,
              "description": "確定事実と推測を区別した原因の評価。"
            }
          }
        },
        "presence_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presence",
            "reason"
          ],
          "properties": {
            "presence": {
              "type": "string",
              "enum": [
                "unknown",
                "likely_present",
                "likely_absent"
              ],
              "description": "入力と許可された現在参照だけに基づく、report 時点の存在可能性。"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200,
              "description": "presence の根拠と不確実性。"
            }
          }
        }
      }
    },
    "related_issue_ids": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "description": "同一 issue ではないが、問題の変質や派生を追うために関係を残す入力候補の issue ID。",
      "items": {
        "type": "string"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "decision": {
          "enum": [
            "existing"
          ]
        },
        "existing_issue_id": {
          "type": "string"
        }
      }
    },
    {
      "properties": {
        "decision": {
          "enum": [
            "new"
          ]
        },
        "existing_issue_id": {
          "type": "null"
        }
      }
    }
  ]
}

#!/bin/sh

set -eu

cmoc_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
venv_python="$cmoc_root/.venv/bin/python"

# 通常ファイル・実行権限だけでは Python として起動できる保証がないため、
# 最小の interpreter probe に失敗した場合も wrapper のエラー報告へ送る。
# {{work-root}}/oracle/doc/dev_rule/development_environment.md
is_usable_venv_python() {
    [ -f "$venv_python" ] \
        && [ -x "$venv_python" ] \
        || return 1

    # 終了コードだけでは任意の executable を通すため、Python code の marker を照合する。
    probe_output=$(
        "$venv_python" -c 'import sys; sys.stdout.write("cmoc-python-probe\n"); sys.exit(0)' \
            2>/dev/null
    ) || return 1
    [ "$probe_output" = "cmoc-python-probe" ]
}

print_missing_venv_error() {
    # {{work-root}}/oracle/doc/app_spec/error_handling.md
    {
        printf '%s\n' "# 失敗: cmoc"
        printf '%s\n' "- 理由: cmoc の仮想環境 Python が見つからないか、実行できません。"
        printf '%s\n' "- 詳細: 必要な実行ファイル \`$venv_python\`"
        printf '%s\n' "- 次の操作: 初回セットアップの場合は、\`$cmoc_root\` で仮想環境を作成し、cmoc をインストールしてください。"
        printf '%s\n' "- 終了コード: \`1\`"
    } >&2
}

require_venv_python() {
    if is_usable_venv_python; then
        return 0
    fi
    print_missing_venv_error
    exit 1
}

is_completion_probe() {
    [ "${_CMOC_COMPLETE+x}" = x ]
}

if is_completion_probe; then
    if is_usable_venv_python; then
        exec "$venv_python" "$cmoc_root/src/main.py" "$@"
    fi
    exit 1
fi

require_venv_python

exec "$venv_python" "$cmoc_root/src/main.py" "$@"
